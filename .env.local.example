# fila-viva-backend base URL (HTTP). Browser calls go through the /api/backend
# rewrite, so the session cookie lives on this frontend's domain.
NEXT_PUBLIC_API_URL=http://localhost:3000
# fila-viva-backend Socket.io URL (usually the same as the API).
NEXT_PUBLIC_WS_URL=http://localhost:3000
# Optional: institution code to use when there is more than one.
NEXT_PUBLIC_INSTITUTION_CODE=banco-demo-centro
